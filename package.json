{
  "name": "convexkit",
  "version": "1.0.0",
  "description": "Edge-ready starter kit for TanStack Start, Convex, Better Auth, and Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -r \"npm:dev:web\" \"npm:dev:convex\"",
    "dev:web": "vite dev",
    "dev:convex": "npx convex dev",
    "build": "vite build && node scripts/sanitize-build-output.mjs",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview vite build --mode preview && node scripts/sanitize-build-output.mjs",
    "build:prod": "cross-env CLOUDFLARE_ENV=production vite build --mode production && node scripts/sanitize-build-output.mjs",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/public-smoke.spec.ts",
    "test:e2e:auth": "playwright test e2e/authenticated-flow.spec.ts",
    "test:cli": "node --test packages/create-convexkit/test/scaffold.node-test.mjs",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run test:coverage && npm run test:cli && npm run test:setup && npm run test:guardrails && npm run check:convex-imports && npm run typecheck && npm audit --audit-level=low && npm run build && npm run docs:build",
    "generate:routes": "node -e \"const{getConfig:g,Generator:G}=require('@tanstack/router-generator');new G({config:g({},process.cwd()),root:process.cwd()}).run()\"",
    "sync:wrangler-config": "node scripts/generate-wrangler-config.mjs",
    "convex:push": "npx convex dev --once",
    "convex:deploy": "npx convex deploy --yes",
    "deploy:preview": "npm run convex:push && npm run build:preview && npm run sync:wrangler-config && wrangler deploy --config dist/server/wrangler.json",
    "deploy:prod": "npm run convex:deploy && npm run build:prod && npm run sync:wrangler-config && wrangler deploy --config dist/server/wrangler.json",
    "cf-typegen": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareBindings",
    "test:scaffold": "node scripts/validate-scaffold.mjs",
    "test:setup": "node --test scripts/setup.node-test.mjs",
    "test:e2e:local-auth": "node scripts/validate-local-auth.mjs",
    "test:guardrails": "node --test scripts/sanitize-build-output.test.mjs scripts/check-convex-runtime-imports.test.mjs",
    "check:convex-imports": "node scripts/check-convex-runtime-imports.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/react-query": "0.1.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "1.6.30",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "resend": "6.26.0",
    "sonner": "2.0.8",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "optionalDependencies": {
    "@sentry/react": "10.73.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.5.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.5",
    "convex-test": "0.0.56",
    "cross-env": "10.1.0",
    "esbuild": "0.27.0",
    "eslint": "10.10.0",
    "happy-dom": "20.14.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "4.1.11",
    "wrangler": "4.133.0"
  }
}
